local currentX, currentY, currentZ = 0, 0, 0

-- Atualização em Tempo Real
RunService.RenderStepped:Connect(function()
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local pos = player.Character.HumanoidRootPart.Position
        currentX = math.round(pos.X)
        currentY = math.round(pos.Y)
        currentZ = math.round(pos.Z)
        
        CoordLabel.Text = string.format("X:  %d\nY:  %d\nZ:  %d", currentX, currentY, currentZ)
    else
        CoordLabel.Text = "X: --\nY: --\nZ: --"
    end
end)

-- Sistema de Cópia
CopyButton.MouseButton1Click:Connect(function()
    local textToCopy = string.format("%d, %d, %d", currentX, currentY, currentZ)
    
    if setclipboard then
        setclipboard(textToCopy)
    elseif toclipboard then
        toclipboard(textToCopy)
    end
    
    local originalText = CopyButton.Text
    CopyButton.Text = "Copiado!"
    CopyButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    task.wait(0.7)
    CopyButton.Text = originalText
    CopyButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
end)

