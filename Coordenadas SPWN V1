end)

-- Lógica de Teletransporte Inteligente (Suporta CFrame completo, Ângulos ou Apenas X, Y, Z)
TeleportButton.MouseButton1Click:Connect(function()
    local text = InputBoxFrame.Text
    if text == "" then return end

    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        
        text = text:gsub("CFRAME", ""):gsub("CFrame", ""):gsub("cframe", "")
        
        local numbers = {}
        for num in text:gmatch("([%-?%d%.]+)") do
            table.insert(numbers, tonumber(num))
        end

        if #numbers >= 3 then
            if #numbers >= 12 then
                -- Matriz CFrame completa do Dex com rotação exata
                hrp.CFrame = CFrame.new(
                    numbers[1], numbers[2], numbers[3],
                    numbers[4], numbers[5], numbers[6],
                    numbers[7], numbers[8], numbers[9],
                    numbers[10], numbers[11], numbers[12]
                )
            elseif #numbers >= 4 then
                -- Se contiver X, Y, Z e um valor extra de ângulo em graus
                local x, y, z, deg = numbers[1], numbers[2], numbers[3], numbers[4]
                local rad = math.rad(deg)
                hrp.CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, rad, 0)
            else
                -- Apenas X, Y, Z simples (mantém a rotação atual do personagem)
                local targetPos = Vector3.new(numbers[1], numbers[2], numbers[3])
                hrp.CFrame = CFrame.new(targetPos, targetPos + hrp.CFrame.LookVector)
            end
            
            TeleportButton.Text = "Sucesso!"
            task.wait(1)
            TeleportButton.Text = "Realizar\nTeletransporte"
        else
            TeleportButton.Text = "Invalido!"
            task.wait(1)
            TeleportButton.Text = "Realizar\nTeletransporte"
        end
    end
end)

