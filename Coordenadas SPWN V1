local currentX, currentY, currentZ = 0, 0, 0
local currentDegrees, currentDirectionLetter = 0, "N"
local currentCFrame = CFrame.new()

-- Função Bússola
local function getCompassDirection(hrp)
    local lookVector = hrp.CFrame.LookVector
    local angle = math.atan2(lookVector.X, lookVector.Z)
    local degrees = math.deg(angle)
    degrees = (degrees + 180) % 360

    local dirLetter = "N"
    if degrees >= 337.5 or degrees < 22.5 then dirLetter = "S"
    elseif degrees >= 22.5 and degrees < 67.5 then dirLetter = "SO"
    elseif degrees >= 67.5 and degrees < 112.5 then dirLetter = "O"
    elseif degrees >= 112.5 and degrees < 157.5 then dirLetter = "NO"
    elseif degrees >= 157.5 and degrees < 202.5 then dirLetter = "N"
    elseif degrees >= 202.5 and degrees < 247.5 then dirLetter = "NE"
    elseif degrees >= 247.5 and degrees < 292.5 then dirLetter = "L"
    elseif degrees >= 292.5 and degrees < 337.5 then dirLetter = "SE"
    end

    return math.round(degrees), dirLetter
end

-- Atualização contínua das Coordenadas e CFrame
local renderConnection
renderConnection = RunService.RenderStepped:Connect(function()
    if not ScreenGui.Parent then
        renderConnection:Disconnect()
        return
    end

    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local pos = hrp.Position

        currentX = math.round(pos.X)
        currentY = math.round(pos.Y)
        currentZ = math.round(pos.Z)
        currentCFrame = hrp.CFrame
        currentDegrees, currentDirectionLetter = getCompassDirection(hrp)

        XVal.Text = tostring(currentX)
        YVal.Text = tostring(currentY)
        ZVal.Text = tostring(currentZ)
        DirVal.Text = string.format("%d° (%s)", currentDegrees, currentDirectionLetter)
    else
        XVal.Text = "--"
        YVal.Text = "--"
        ZVal.Text = "--"
        DirVal.Text = "--"
    end
end)

-- Copiar Coordenadas Completas (Incluindo Ângulo/Direção ou CFrame)
CopyButton.MouseButton1Click:Connect(function()
    local textToCopy = string.format("%d, %d, %d | Dir: %d° (%s)", currentX, currentY, currentZ, currentDegrees, currentDirectionLetter)

    if setclipboard then
