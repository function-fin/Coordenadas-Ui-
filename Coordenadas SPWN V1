----------------------------------------------------------------
-- Lógica de Funcionamento e Conversão de Ângulo
----------------------------------------------------------------

local currentX, currentY, currentZ = 0, 0, 0
local currentDegrees = 0
local currentDirectionLetter = "N"

-- Função de conversão para bússola do Roblox
local function getCompassDirection(hrp)
    local lookVector = hrp.CFrame.LookVector
    local angle = math.atan2(lookVector.X, lookVector.Z)
    local degrees = math.deg(angle)
    
    degrees = (degrees + 180) % 360
    
    local dirLetter = "N"
    if degrees >= 337.5 or degrees < 22.5 then
        dirLetter = "S"
    elseif degrees >= 22.5 and degrees < 67.5 then
        dirLetter = "SO"
    elseif degrees >= 67.5 and degrees < 112.5 then
        dirLetter = "O"
    elseif degrees >= 112.5 and degrees < 157.5 then
        dirLetter = "NO"
    elseif degrees >= 157.5 and degrees < 202.5 then
        dirLetter = "N"
    elseif degrees >= 202.5 and degrees < 247.5 then
        dirLetter = "NE"
    elseif degrees >= 247.5 and degrees < 292.5 then
        dirLetter = "L"
    elseif degrees >= 292.5 and degrees < 337.5 then
        dirLetter = "SE"
    end
    
    return math.round(degrees), dirLetter
end

-- Atualização em Tempo Real
RunService.RenderStepped:Connect(function()
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local pos = hrp.Position
        
        currentX = math.round(pos.X)
        currentY = math.round(pos.Y)
        currentZ = math.round(pos.Z)
        currentDegrees, currentDirectionLetter = getCompassDirection(hrp)
        
        CoordLabel.Text = string.format("X:  %d\nY:  %d\nZ:  %d\nDir:  %d° (%s)", currentX, currentY, currentZ, currentDegrees, currentDirectionLetter)
    else
        CoordLabel.Text = "X: --\nY: --\nZ: --\nDir: --"
    end
end)

